{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent/session-context.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/agent/stop-check.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(scripts/agent/plan.py *)",
      "Bash(python3 scripts/agent/plan.py *)",
      "Bash(scripts/deploy.sh)",
      "Bash(make check-fast)",
      "Bash(make check)",
      "Bash(pnpm install)",
      "Bash(pnpm -s typecheck)",
      "Bash(pnpm -s test)",
      "Bash(pnpm -s test:slow)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm dev *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(git tag ring-*)",
      "Bash(git push origin ring-*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.config/groundwork/env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
